{
  "name": "grave-shift",
  "version": "1.0.0",
  "description": "A browser zombie rail shooter built with three.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/game.js --watch --servedir=."
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
